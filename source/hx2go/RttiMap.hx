package hx2go;

class RttiMap {
	static var finished = new sys.thread.Semaphore(0);
	static var fallbackOutputDir:String = "";
	static var fallbackGopackage:String = "";

	static public function awaitBuild() {
		if (!finished.tryAcquire(1)) // try to acquire the semaphore with a timeout in seconds
		{ // timeout occurred, fallback to default Rtti.getRtti()
			if (fallbackOutputDir != "" && fallbackGopackage != "") {
				writeGoFile(fallbackOutputDir, fallbackGopackage, "");
				Sys.println("Timeout waiting for RttiMap build from XML to finish, fallback to default Rtti.getRtti()");
			} else {
				throw "RttiMap build timed out and no fallback output directory or Go package specified";
			}
		}
	}

	static function writeGoFile(outputDir:String, gopackage:String, mapEntries:String) {
		sys.io.File.saveContent(haxe.io.Path.join([outputDir, "rttimap.go"]),
			"// This code was automatically generated by class RttiMap in hx2go; DO NOT EDIT.\n"
			+ "package "
			+ gopackage
			+ "\n\nvar HxRttiMap = map[string]string{\n"
			+ mapEntries
			+ "}\n");
	}

	static public function startThreadedBuild(gopackage:String, inputHxb:String, outputDir:String) {
		fallbackOutputDir = outputDir;
		fallbackGopackage = gopackage;
		sys.thread.Thread.create(function() {
			var mapEntries = "";

			#if go
			var input:String = StringTools.replace(inputHxb, ".hxb", ".xml");
			mapEntries = process(input);
			#end

			writeGoFile(outputDir, gopackage, mapEntries);

			finished.release();
		});
	}

	#if go
	static function process(filePath:String):String {
		var fTup = go.Os.open(filePath);
		if (fTup.tuple().error != null) {
			return "";
		}
		var f = fTup.tuple().result;

		var xmlClasses = run(f); // call the run function with the opened file

		var goOutput = go.Bytes.newBuffer([]);

		for (cl in xmlClasses) {
			goOutput.writeString("\t" + go.Strconv.quoteToASCII(cl.path) + " : " + go.Strconv.quoteToASCII(cl.xml) + ",\n");
		}
		return goOutput.string();
	}

	static var tokenStrings:Array<go.Slice<go.Byte>> = [
		go.Syntax.code('[]byte{9}'),
		go.Syntax.code('[]byte{10}'),
		go.Syntax.code('[]byte(\"<class path=\\\x22\")'), // \x22 == "
		go.Syntax.code('[]byte(\"</class>\")'),
		go.Syntax.code('[]byte(\"<extends \")'),
		go.Syntax.code('[]byte(\"<m n=\\\x22:rtti\\\x22/>\")') // \x22 == "
	];
	static final tokenTab = 0;
	static final tokenNewline = 1;
	static final tokenStartClass = 2;
	static final tokenEndClass = 3;
	static final tokenExtends = 4;
	static final tokenRtti = 5;

	static function tokenIndex(token:go.Slice<go.Byte>):Int {
		for (iToken in 0...tokenStrings.length) {
			if (go.Bytes.equal(token, tokenStrings[iToken])) {
				return iToken;
			}
		}
		return -1;
	}

	static function splitFn2(data:go.Slice<go.Byte>, atEOF:Bool):RttiMap_splitFn2_tuple {
		var ret:RttiMap_splitFn2_tuple;

		for (i in 0...data.length) {
			// look for individual tokens
			for (iToken in 0...tokenStrings.length) {
				if (go.Bytes.hasPrefix(data.slice(i), tokenStrings[iToken])) {
					// found a token at this position
					if (i == 0) {
						// token found at the start of the data
						ret = new RttiMap_splitFn2_tuple(tokenStrings[iToken].length, tokenStrings[iToken], null);
						return ret;
					} else {
						// return a token up to but not including the current byte
						ret = new RttiMap_splitFn2_tuple(i, data.slice(0, i), null);
						return ret;
					}
				}
			}
		}

		if (atEOF) {
			// reached end of file without finding a token, means we should return what we have with an error
			ret = new RttiMap_splitFn2_tuple(data.length, data, null /* go.Fmt.errorf("scanner at EOF") */);
			return ret;
		}

		// if we reach here, no individual tokens were found, so ask for more
		ret = new RttiMap_splitFn2_tuple(0, null, null);
		return ret;
	};

	public static function run(f:go.Pointer<go.os.File>):Array<{path:String, xml:String}> {
		go.Syntax.defer(() -> f.close());
		var scanner = go.Bufio.newScanner(go.Bufio.newReader(f));

		// Set the split function for the scanning operation.
		var splitFn:go.bufio.SplitFunc = go.Syntax.code("func(data []byte, atEOF bool) (advance int, token []byte, err error) { 
			str := {0}(data, atEOF)
			return str.Hx_Field_advance, str.Hx_Field_token, str.Hx_Field_err
		}", splitFn2);
		// Set the split function for the scanner
		go.Syntax.code("{0}.Split({1})", scanner, splitFn);

		// return values
		var xmlClasses:Array<{path:String, xml:String}> = [];

		// State variables for tracking the current parsing state
		var inClass = false;
		var classValid = false;
		var inLineStart = false;
		var getClassPath = false;

		var classPath:go.Slice<go.Byte> = null; // TODO use haxe StringBuf

		var classBuffer:go.bytes.Buffer = go.Syntax.code("HxDefault[bytes.Buffer]()"); // TODO use haxe StringBuf instead of go.bytes.Buffer

		var token:go.Slice<go.Byte> = null;
		while (scanner.scan()) {
			token = go.Slices.clone(scanner.bytes()); // make a copy of the token, so it won't be overwritten by the next scan
			if (inClass) {
				classBuffer.write(token);
				if (getClassPath) {
					var tup = go.Bytes.cut(token, go.Syntax.code('[]byte{34}')); // double quote character
					if (tup.found) {
						classPath = tup.before;
					} else {
						classPath = null;
					}
					getClassPath = false;
				}
			}
			switch (tokenIndex(token)) {
				case tokenNewline:
					inLineStart = true;

				case tokenTab:
					// ignore tabs

				case tokenStartClass:
					if (inLineStart) {
						inClass = true;
						classValid = false;
						getClassPath = true;
						classBuffer.reset();
						classBuffer.write(token);
					}
					inLineStart = false;

				case tokenEndClass:
					if (inClass) {
						if (classValid && classPath != null) {
							xmlClasses.push({path: go.Go.string(classPath), xml: classBuffer.string()});
						}
						inClass = false;
						classValid = false;
					}
					inLineStart = false;

				case tokenExtends, tokenRtti:
					if (inClass) {
						classValid = true;
					}
					inLineStart = false;

				case _:
					inLineStart = false;
			}
		}
		return xmlClasses;
	}
	#end
}

#if go
@:go.Static
class RttiMap_splitFn2_tuple {
	var advance:go.GoInt;
	var token:go.Slice<go.Byte>;
	var err:go.Error;

	public function new(advance:go.GoInt, token:go.Slice<go.Byte>, err:go.Error) {
		this.advance = advance;
		this.token = token;
		this.err = err;
	}
}
#end
