+function epochMillis():String {
+	var v = Math.ffloor(Date.now().getTime());
+	if (v <= 0)
+		return "0";
+	var digits = "";
+	while (v >= 1) {
+		var d = Std.int(v - Math.ffloor(v / 10) * 10);
+		digits = String.fromCharCode("0".code + d) + digits;
+		v = Math.ffloor(v / 10);
+	}
+	return digits;
+}
